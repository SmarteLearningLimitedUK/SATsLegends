{
  "name": "sats-legends",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:with-english": "node scripts/build-with-english.mjs",
    "build:cloudflare-english-test": "node scripts/build-cloudflare-with-english.mjs",
    "preview": "vite preview",
    "build:ftp": "node scripts/build-ftp.mjs",
    "verify:family-db": "node scripts/verify-family-database.mjs",
    "verify:production-db": "node scripts/verify-production-database.mjs",
    "verify:admin-db": "node scripts/verify-admin-database.mjs",
    "verify:responsive": "node scripts/verify-responsive-experience.mjs",
    "verify:critical-game-viewports": "node scripts/verify-critical-game-viewports.mjs",
    "verify:lexcoria": "node scripts/verify-lexcoria-readiness.mjs",
    "verify:family-ui": "node scripts/verify-family-website.mjs",
    "verify:family-auth": "node scripts/verify-family-auth-flow.mjs",
    "verify:return-path": "tsx scripts/verify-return-path.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.59.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
