hadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), 0 10px 20px rgba(14, 116, 144, 0.18);\n}\n.pvp-slot::before {\n  content: '';\n  position: absolute;\n  inset: 0.35rem;\n  border-radius: 0.85rem;\n  border: 1px solid rgba(255, 255, 255, 0.22);\n  pointer-events: none;\n}\n.pvp-slot-label {\n  text-shadow: 0 2px 8px rgba(2, 6, 23, 0.36);\n}\n.pvp-slot-digit {\n  text-shadow: 0 2px 0 rgba(7, 15, 33, 0.4), 0 8px 16px rgba(56, 189, 248, 0.2);\n}\n.pvp-slot-square-socket {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: clamp(4.5rem, 9vw, 5.75rem);\n  height: clamp(4.5rem, 9vw, 5.75rem);\n  border-radius: 0.8rem;\n  background: url('/src/assets/place_value/frames/large_avatar_frame.png') center/contain no-repeat, radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.34), rgba(56, 189, 248, 0.2));\n  border: none;\n  box-shadow: 0 8px 14px rgba(14, 116, 144, 0.22), 0 0 18px rgba(250, 204, 21, 0.24);\n}\n.pvp-slot-square-socket::before {\n  content: '';\n  position: absolute;\n  inset: 0.5rem;\n  border-radius: 0.56rem;\n  border: 1px solid rgba(253, 224, 71, 0.4);\n  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.36), rgba(186, 230, 253, 0.24));\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), inset 0 -2px 0 rgba(30, 64, 175, 0.2);\n  pointer-events: none;\n}\n.pvp-slot-empty-square-glyph {\n  font-size: clamp(1.2rem, 2.7vw, 1.55rem);\n  font-weight: 900;\n  color: rgba(15, 23, 42, 0.6);\n  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4), 0 5px 10px rgba(14, 116, 144, 0.2);\n}\n.pvp-slot-square-gem {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: calc(100% - 0.74rem);\n  height: calc(100% - 0.74rem);\n  isolation: isolate;\n  border-radius: 0.52rem;\n  overflow: hidden;\n  box-shadow: 0 7px 14px rgba(2, 6, 23, 0.46), 0 0 16px rgba(255, 255, 255, 0.14), 0 0 20px rgba(125, 211, 252, 0.24);\n}\n.pvp-slot-square-gem-digit {\n  position: relative;\n  z-index: 2;\n  font-size: clamp(1.3rem, 3vw, 1.66rem);\n  font-weight: 900;\n  color: #ffffff;\n  text-shadow: 0 2px 0 rgba(2, 6, 23, 0.86), 0 8px 10px rgba(2, 6, 23, 0.6), 0 0 8px rgba(255, 255, 255, 0.28);\n}\n.pvp-slot-filled {\n  border-color: rgba(253, 224, 71, 0.68) !important;\n  background: radial-gradient(circle at 50% 0%, rgba(253, 224, 71, 0.32), rgba(253, 224, 71, 0) 38%), linear-gradient(180deg, rgba(226, 242, 255, 0.34), rgba(56, 189, 248, 0.26)) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26), 0 12px 24px rgba(250, 204, 21, 0.24) !important;\n}\n.pvp-slot-hovered {\n  border-color: rgba(253, 224, 71, 0.82) !important;\n  background: radial-gradient(circle at 50% 0%, rgba(253, 224, 71, 0.3), rgba(253, 224, 71, 0) 34%), linear-gradient(180deg, rgba(226, 242, 255, 0.34), rgba(56, 189, 248, 0.26)) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 0 0 2px rgba(253, 224, 71, 0.34), 0 14px 26px rgba(250, 204, 21, 0.26) !important;\n}\n.pvp-slot-hinted {\n  border-color: rgba(254, 249, 195, 0.86) !important;\n  background: radial-gradient(circle at 50% 0%, rgba(253, 224, 71, 0.22), rgba(253, 224, 71, 0) 36%), linear-gradient(180deg, rgba(11, 30, 58, 0.86), rgba(8, 20, 39, 0.9)) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 0 2px rgba(253, 224, 71, 0.34), 0 12px 24px rgba(245, 158, 11, 0.24) !important;\n}\n.pvp-slot-empty {\n  border-color: rgba(250, 204, 21, 0.28) !important;\n}\n.pvp-slot-correct-flash {\n  animation: pvp-slot-correct-flash 0.34s ease-out;\n}\n@keyframes pvp-slot-correct-flash {\n  0% {\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 0 0 0 rgba(52, 211, 153, 0.5), 0 14px 28px rgba(16, 185, 129, 0.3);\n    transform: scale(1);\n  }\n  55% {\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 0 0 4px rgba(52, 211, 153, 0.2), 0 16px 32px rgba(16, 185, 129, 0.34);\n    transform: scale(1.02);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n.pvp-tray-shell {\n  background: radial-gradient(circle at 8% 0%, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 38%), radial-gradient(circle at 90% 12%, rgba(253, 224, 71, 0.16), rgba(253, 224, 71, 0) 38%), linear-gradient(180deg, rgba(226, 242, 255, 0.3), rgba(56, 189, 248, 0.2));\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), 0 12px 22px rgba(14, 116, 144, 0.18);\n  min-height: clamp(10rem, 22vh, 14.2rem);\n  max-height: clamp(11rem, 27vh, 15.75rem);\n  border-top-left-radius: 1.05rem;\n  border-top-right-radius: 1.05rem;\n}\n.pvp-digit-tile {\n  border-color: rgba(253, 224, 71, 0.42) !important;\n  background: radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 44%), linear-gradient(180deg, rgba(226, 242, 255, 0.36), rgba(56, 189, 248, 0.28)) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.34), 0 10px 16px rgba(14, 116, 144, 0.2);\n  text-shadow: 0 1px 0 rgba(7, 15, 33, 0.35), 0 6px 14px rgba(56, 189, 248, 0.18);\n}\n.pvp-digit-tile:hover {\n  filter: brightness(1.1) saturate(1.1);\n  transform: translateY(-1px);\n}\n.pvp-digit-gem-square {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: min(100%, 4.95rem);\n  height: min(100%, 4.95rem);\n  overflow: hidden;\n  border-radius: 0.58rem !important;\n  box-shadow: 0 10px 16px rgba(2, 6, 23, 0.45), 0 0 16px rgba(255, 255, 255, 0.14), 0 0 22px rgba(125, 211, 252, 0.24) !important;\n}\n.pvp-gem-art {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  pointer-events: none;\n  user-select: none;\n  filter: saturate(1.34) contrast(1.14) brightness(1.08);\n}\n.pvp-digit-gem-number {\n  position: relative;\n  z-index: 2;\n  font-size: clamp(1.25rem, 3vw, 1.72rem);\n  font-weight: 900;\n  color: #ffffff;\n  text-shadow: 0 2px 0 rgba(2, 6, 23, 0.92), 0 8px 14px rgba(2, 6, 23, 0.62), 0 0 10px rgba(255, 255, 255, 0.28);\n}\n.pvp-digit-selected {\n  filter: brightness(1.14) saturate(1.16);\n  transform: scale(1.05);\n  box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.72), inset 0 -3px 0 rgba(9, 16, 30, 0.56), 0 3px 0 rgba(94, 45, 10, 0.28), 0 11px 20px rgba(2, 6, 23, 0.42), 0 0 20px rgba(125, 211, 252, 0.42) !important;\n}\n.pvp-drag-ghost {\n  overflow: hidden;\n  border-radius: 0.74rem;\n  background: transparent;\n  box-shadow: 0 10px 20px rgba(14, 116, 144, 0.24), 0 0 24px rgba(250, 204, 21, 0.28) !important;\n}\n.pvp-forge-pulse {\n  animation: pvp-forge-pulse 0.62s ease-out;\n}\n@keyframes pvp-forge-pulse {\n  0% {\n    transform: scale(1);\n    filter: brightness(1);\n  }\n  35% {\n    transform: scale(1.14);\n    filter: brightness(1.25);\n  }\n  100% {\n    transform: scale(1);\n    filter: brightness(1);\n  }\n}\n.pvp-forged-burst {\n  padding: 0.6rem 1.1rem;\n  border-radius: 999px;\n  border: 1px solid rgba(186, 230, 253, 0.72);\n  background: radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0) 62%), linear-gradient(180deg, rgba(45, 212, 191, 0.45), rgba(37, 99, 235, 0.4));\n  color: #f8fdff;\n  font-size: clamp(1.2rem, 2.9vw, 1.85rem);\n  font-weight: 900;\n  letter-spacing: 0.08em;\n  text-shadow: 0 2px 0 rgba(2, 6, 23, 0.72), 0 8px 16px rgba(14, 165, 233, 0.42);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 14px 28px rgba(2, 6, 23, 0.38), 0 0 28px rgba(45, 212, 191, 0.36);\n}\n.avatar-select-screen {\n  background: transparent;\n  min-height: 100%;\n  height: 100%;\n  width: 100%;\n}\n.avatar-select-background {\n  object-fit: cover;\n  object-position: 50% 8%;\n  transform: scale(1.05);\n  transform-origin: center top;\n}\n.avatar-select-layout {\n  gap: 0;\n}\n.avatar-carousel-header {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  margin-top: calc(env(safe-area-inset-top) + 62px);\n  pointer-events: none;\n}\n.avatar-carousel-banner {\n  position: relative;\n  width: 100%;\n  max-width: clamp(17rem, 90vw, 42rem);\n  height: clamp(4.8rem, 10vh, 8.1rem);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-inline: auto;\n  overflow: visible;\n}\n.avatar-carousel-banner-art {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: clamp(23.75rem, 115vw, 52.5rem);\n  transform: translate(calc(-50% - 10px), -50%);\n  height: auto;\n  max-width: none;\n  max-height: none;\n  object-fit: contain;\n  transform-origin: center;\n  object-position: center center;\n  filter: drop-shadow(0 8px 14px rgba(2, 6, 23, 0.3));\n}\n.avatar-name-panel {\n  margin-top: calc(clamp(-0.65rem, -1.25vh, -0.2rem) + 50px);\n  padding-block: clamp(0.35rem, 0.9vh, 0.65rem);\n}\n.avatar-carousel-title {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  margin: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding-inline: clamp(1.5rem, 6vw, 3.5rem);\n  transform: translateY(0);\n  font-weight: 900;\n  font-size: clamp(1.12rem, 4.2vw, 1.72rem);\n  letter-spacing: 0.085em;\n  line-height: 1;\n  text-transform: uppercase;\n  color: #fff7d6;\n  text-align: center;\n  text-shadow: 0 2px 0 rgba(56, 17, 7, 0.42), 0 6px 12px rgba(2, 6, 23, 0.35);\n}\n.avatar-hero-stage {\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  align-items: flex-end;\n  padding-bottom: clamp(2.5rem, 7vh, 4.5rem);\n}\n.avatar-carousel-track {\n  position: relative;\n  z-index: 12;\n  width: min(100%, 46rem);\n  height: 100%;\n  display: grid;\n  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.5fr) minmax(0, 0.95fr);\n  align-items: end;\n  column-gap: clamp(0.15rem, 1vw, 0.65rem);\n  padding: clamp(0.1rem, 0.8vw, 0.3rem) clamp(1.2rem, 5.4vw, 3rem) clamp(0.15rem, 1vw, 0.35rem);\n  overflow: visible;\n  transform: translateY(clamp(1.1rem, 2.7vh, 2.1rem));\n}\n.avatar-carousel-main {\n  align-self: end;\n  height: 100%;\n  min-height: 0;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  overflow: visible;\n}\n.avatar-carousel-main.avatar-carousel-main-only {\n  grid-column: 2 / 3;\n}\n.avatar-carousel-side {\n  align-self: end;\n  border: 0;\n  background: transparent;\n  height: 100%;\n  min-height: 0;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  cursor: pointer;\n  opacity: 0.46;\n  filter: saturate(0.8) brightness(0.9);\n  transition: opacity 0.2s ease, filter 0.2s ease;\n  overflow: visible;\n}\n.avatar-carousel-side:hover {\n  opacity: 0.86;\n  filter: saturate(0.95) brightness(0.98);\n}\n.avatar-carousel-side-left {\n  transform: translateX(10%) scale(0.82);\n}\n.avatar-carousel-side-right {\n  transform: translateX(-10%) scale(0.82);\n}\n.avatar-hero-arrow {\n  position: absolute;\n  top: 56%;\n  z-index: 20;\n  transform: translateY(-50%);\n  width: clamp(4.35rem, 10.5vw, 5.25rem);\n  height: clamp(4.35rem, 10.5vw, 5.25rem);\n  border-radius: 999px;\n  border: 1px solid rgba(178, 227, 255, 0.42);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(180deg, rgba(74, 156, 255, 0.92), rgba(35, 88, 197, 0.95));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.32), 0 8px 18px rgba(2, 6, 23, 0.28);\n}\n.avatar-hero-arrow-glyph {\n  display: block;\n  width: 1.28rem;\n  height: 1.28rem;\n  border-top: 0.28rem solid #fff8e6;\n  border-right: 0.28rem solid #fff8e6;\n  filter: drop-shadow(0 1px 0 rgba(18, 49, 114, 0.4));\n}\n.avatar-hero-arrow-glyph-left {\n  transform: rotate(-135deg) translate(-6%, 6%);\n}\n.avatar-hero-arrow-glyph-right {\n  transform: rotate(45deg) translate(-6%, 6%);\n}\nbutton.avatar-hero-arrow:not(:disabled):active {\n  transform: translateY(calc(-50% + 1px)) !important;\n  filter: none !important;\n}\n.avatar-hero-arrow-left {\n  left: calc(clamp(0.1rem, 1vw, 0.45rem) + 10px);\n}\n.avatar-hero-arrow-right {\n  right: calc(clamp(0.1rem, 1vw, 0.45rem) + 10px);\n}\n.avatar-hero-nameplate {\n  min-height: 2.3rem;\n  width: min(100%, 18rem);\n  margin-inline: auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-size: clamp(1.1rem, 4.2vw, 1.55rem);\n  font-weight: 900;\n  color: #f8fafc;\n  text-shadow: 0 2px 0 rgba(2, 6, 23, 0.62), 0 8px 14px rgba(2, 6, 23, 0.38);\n}\n.avatar-hero-nameplate-under-banner {\n  margin-top: clamp(0.1rem, 0.6vh, 0.45rem);\n  margin-bottom: clamp(0.2rem, 0.9vh, 0.7rem);\n  position: relative;\n  z-index: 13;\n}\n.avatar-hero-name-banner {\n  position: relative;\n  z-index: 13;\n  width: min(100%, clamp(16rem, 62vw, 24rem));\n  aspect-ratio: 3 / 1;\n  margin-inline: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.avatar-hero-name-banner-under-title {\n  margin-top: clamp(0.05rem, 0.3vh, 0.25rem);\n  margin-bottom: clamp(0.2rem, 0.9vh, 0.7rem);\n}\n.iphone-game-stage .avatar-select-screen {\n  height: 100%;\n  min-height: 0;\n}\n.iphone-game-stage .avatar-carousel-header {\n  margin-top: calc(env(safe-area-inset-top) + 58px);\n}\n.iphone-game-stage .avatar-carousel-banner {\n  max-width: calc(var(--game-stage-width, 390px) * 0.92);\n  height: calc(var(--game-stage-height, 844px) * 0.105);\n}\n.iphone-game-stage .avatar-carousel-banner-art {\n  width: calc(var(--game-stage-width, 390px) * 1.6);\n  top: 50%;\n}\n.iphone-game-stage .avatar-carousel-track {\n  width: calc(var(--game-stage-width, 390px) * 0.8);\n  transform: translateY(calc(var(--game-stage-height, 844px) * 0.02));\n}\n.iphone-game-stage .avatar-hero-arrow {\n  width: calc(var(--game-stage-width, 390px) * 0.16);\n  height: calc(var(--game-stage-width, 390px) * 0.16);\n}\n.avatar-hero-name-banner-art {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  transform: scale(2);\n  transform-origin: center center;\n  filter: drop-shadow(0 6px 12px rgba(2, 6, 23, 0.32));\n}\n.avatar-hero-name-banner-art-cyan {\n  filter: hue-rotate(152deg) saturate(1.4) brightness(1.08) drop-shadow(0 8px 12px rgba(3, 105, 161, 0.3));\n}\n.avatar-hero-name-banner-text {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  align-i