ark-c {\n  transform: translate(120%, 15%);\n  animation-delay: 1.4s;\n}\n.world-map-orbit {\n  position: absolute;\n  inset: 0;\n  animation-name: world-map-orbit;\n  animation-timing-function: linear;\n  animation-iteration-count: infinite;\n}\n.world-map-orbit-birds {\n  opacity: 0.92;\n}\n.world-map-orbit-stars {\n  opacity: 0.94;\n}\n.world-map-butterfly {\n  position: absolute;\n  width: 0.9rem;\n  height: 0.6rem;\n  animation-name: world-map-butterfly-drift;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-butterfly::before, .world-map-butterfly::after {\n  content: '';\n  position: absolute;\n  top: 0.06rem;\n  width: 0.42rem;\n  height: 0.5rem;\n  border-radius: 70% 40% 60% 45%;\n  background: linear-gradient(180deg, rgba(255,250,192,0.95), rgba(255,187,79,0.92));\n  box-shadow: 0 0 10px rgba(255,211,102,0.32);\n}\n.world-map-butterfly::before {\n  left: 0.02rem;\n  transform: rotate(-28deg);\n}\n.world-map-butterfly::after {\n  right: 0.02rem;\n  transform: rotate(28deg);\n}\n.world-map-bubble {\n  position: absolute;\n  width: 0.72rem;\n  height: 0.72rem;\n  border-radius: 999px;\n  border: 1px solid rgba(194,242,255,0.55);\n  background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.56), rgba(176, 247, 255, 0.18) 46%, rgba(176,247,255,0) 72%);\n  box-shadow: 0 0 12px rgba(137, 248, 255, 0.18);\n  animation-name: world-map-bubble-rise;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-bubble::after {\n  content: '';\n  position: absolute;\n  left: 22%;\n  top: 16%;\n  width: 0.18rem;\n  height: 0.18rem;\n  border-radius: 999px;\n  background: rgba(255,255,255,0.78);\n}\n.world-map-sparkle, .world-map-star {\n  position: absolute;\n  width: 0.7rem;\n  height: 0.7rem;\n  border-radius: 0.12rem;\n  background: linear-gradient(180deg, rgba(255,252,225,0.98), rgba(255,216,102,0.94));\n  transform: rotate(45deg);\n  box-shadow: 0 0 12px rgba(255,223,120,0.3);\n}\n.world-map-star {\n  left: 50%;\n  top: 8%;\n  transform: translateX(-50%) rotate(45deg);\n}\n.world-map-sparkle {\n  animation-name: world-map-sparkle-pop;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-sparkle::before, .world-map-sparkle::after, .world-map-star::before, .world-map-star::after {\n  content: '';\n  position: absolute;\n  inset: 50%;\n  border-radius: 999px;\n  background: linear-gradient(180deg, rgba(255,252,235,0.96), rgba(255,214,87,0));\n  transform: translate(-50%, -50%);\n}\n.world-map-sparkle::before, .world-map-star::before {\n  width: 24%;\n  height: 138%;\n}\n.world-map-sparkle::after, .world-map-star::after {\n  width: 138%;\n  height: 24%;\n}\n.world-map-bird {\n  position: absolute;\n  left: 50%;\n  top: 8%;\n  width: 1.2rem;\n  height: 0.7rem;\n  transform: translateX(-50%);\n}\n.world-map-bird::before, .world-map-bird::after {\n  content: '';\n  position: absolute;\n  top: 0.2rem;\n  width: 0.52rem;\n  height: 0.2rem;\n  border-top: 2px solid rgba(22,24,32,0.92);\n}\n.world-map-bird::before {\n  left: 0.08rem;\n  transform: rotate(-26deg);\n  transform-origin: right center;\n}\n.world-map-bird::after {\n  right: 0.08rem;\n  transform: rotate(26deg);\n  transform-origin: left center;\n}\n.world-map-light-beam {\n  position: absolute;\n  width: 0.95rem;\n  height: 3.6rem;\n  border-radius: 999px;\n  background: linear-gradient(180deg, rgba(255,255,255,0), rgba(255,255,255,0.74) 26%, rgba(144,240,255,0.68) 52%, rgba(144,240,255,0));\n  filter: blur(0.8px);\n  mix-blend-mode: screen;\n  animation-name: world-map-light-beam-flash;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-dust-devil {\n  position: absolute;\n  width: 1.3rem;\n  height: 2rem;\n  border-radius: 999px;\n  background: radial-gradient(circle at 50% 18%, rgba(255,230,190,0.28), rgba(255,230,190,0) 38%), linear-gradient(180deg, rgba(236,200,150,0.04), rgba(220,184,135,0