02);\n    opacity: 0.30;\n  }\n  100% {\n    transform: translate3d(-2%, 0, 0) scale(1);\n    opacity: 0.20;\n  }\n}\n@keyframes sat-boss-pulse {\n  0% {\n    opacity: 0.18;\n    transform: scale(0.99);\n  }\n  50% {\n    opacity: 0.32;\n    transform: scale(1.01);\n  }\n  100% {\n    opacity: 0.18;\n    transform: scale(0.99);\n  }\n}\n@keyframes sat-boss-parallax-far {\n  0% {\n    transform: translate3d(-1.2%, -0.6%, 0) scale(1.06);\n    opacity: 0.62;\n  }\n  50% {\n    transform: translate3d(1.2%, 0.8%, 0) scale(1.06);\n    opacity: 0.78;\n  }\n  100% {\n    transform: translate3d(-1.2%, -0.6%, 0) scale(1.06);\n    opacity: 0.62;\n  }\n}\n@keyframes sat-boss-parallax-mid {\n  0% {\n    transform: translate3d(1.4%, 0.2%, 0) scale(1.06);\n    opacity: 0.60;\n  }\n  50% {\n    transform: translate3d(-1.4%, -0.8%, 0) scale(1.06);\n    opacity: 0.78;\n  }\n  100% {\n    transform: translate3d(1.4%, 0.2%, 0) scale(1.06);\n    opacity: 0.60;\n  }\n}\n@keyframes sat-boss-parallax-fore {\n  0% {\n    transform: translate3d(-2.2%, 0.8%, 0) scale(1.06);\n    opacity: 0.46;\n  }\n  50% {\n    transform: translate3d(2.0%, -0.6%, 0) scale(1.06);\n    opacity: 0.62;\n  }\n  100% {\n    transform: translate3d(-2.2%, 0.8%, 0) scale(1.06);\n    opacity: 0.46;\n  }\n}\n.boss-parallax-layer {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 2;\n  overflow: hidden;\n}\n.boss-parallax {\n  position: absolute;\n  inset: -10%;\n  pointer-events: none;\n  background: radial-gradient(circle at 20% 18%, var(--boss-parallax-b), rgba(255,255,255,0) 52%), radial-gradient(circle at 78% 24%, var(--boss-parallax-a), rgba(255,255,255,0) 56%), radial-gradient(circle at 50% 62%, rgba(2,6,23,0.0), rgba(2,6,23,0.32) 68%), repeating-radial-gradient(circle at 32% 34%, rgba(255,255,255,0.07) 0 1px, rgba(255,255,255,0) 1px 16px);\n  mix-blend-mode: screen;\n}\n.boss-parallax--far {\n  opacity: 0.62;\n  animation: sat-boss-parallax-far 22s ease-in-out infinite;\n}\n.boss-parallax--mid {\n  opacity: 0.56;\n  animation: sat-boss-parallax-mid 18s ease-in-out infinite;\n}\n.boss-parallax--fore {\n  opacity: 0.46;\n  animation: sat-boss-parallax-fore 14s ease-in-out infinite;\n  mix-blend-mode: soft-light;\n}\n.boss-atmosphere-layer {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 3;\n  overflow: hidden;\n}\n.boss-atmo-vignette {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at 50% 55%, rgba(2,6,23,0) 36%, rgba(2,6,23,0.34) 78%), linear-gradient(180deg, rgba(2,6,23,0.10) 0%, rgba(2,6,23,0.18) 42%, rgba(2,6,23,0.50) 100%);\n  opacity: 0.75;\n}\n.boss-atmo-radial {\n  position: absolute;\n  inset: -6%;\n  background: radial-gradient(circle at 68% 38%, var(--boss-glow-a), rgba(2,6,23,0) 55%), radial-gradient(circle at 34% 46%, var(--boss-glow-b), rgba(2,6,23,0) 62%);\n  opacity: 0.75;\n  animation: sat-boss-pulse 10s ease-in-out infinite;\n}\n.boss-atmo-fog {\n  position: absolute;\n  inset: -12% -8%;\n  background: radial-gradient(circle at 18% 78%, rgba(255,255,255,0.08), rgba(255,255,255,0) 58%), radial-gradient(circle at 72% 84%, rgba(56,189,248,0.10), rgba(2,6,23,0) 62%), linear-gradient(180deg, rgba(2,6,23,0) 0%, var(--boss-fog) 88%);\n  opacity: 0.34;\n  filter: blur(6px);\n  animation: sat-boss-fog 16s ease-in-out infinite;\n}\n.boss-atmo-fog--mid {\n  opacity: 0.22;\n  filter: blur(10px);\n  animation-duration: 22s;\n}\n.boss-atmo-particles {\n  position: absolute;\n  inset: 0;\n}\n.boss-atmo-particle {\n  position: absolute;\n  border-radius: 999px;\n  background: radial-gradient(circle at 40% 35%, var(--boss-mote-a), rgba(255,255,255,0) 62%), radial-gradient(circle at 60% 65%, var(--boss-mote-b), rgba(255,255,255,0) 72%);\n  animation: sat-boss-drift 14s ease-in-out infinite;\n  transform: translateZ(0);\n}\n.boss-atmo-particle--spark {\n  border-radius: 10px;\n  transform: rotate(12deg);\n  background: radial-gradient(circle at 38% 36%, rgba(255,255,255,0.92), rgba(255,255,255,0) 48%), radial-gradient(circle at 65% 66%, var(--boss-mote-b), rgba(255,255,255,0) 62%);\n  mix-blend-mode: screen;\n}\n@media (prefers-reduced-motion: reduce) {\n  .sat-calm-drift, .sat-calm-breathe, .sat-calm-fog, .sat-runic-shimmer, .boss-parallax--far, .boss-parallax--mid, .boss-parallax--fore, .boss-atmo-fog, .boss-atmo-radial, .boss-atmo-particle {\n    animation: none !important;\n  }\n  .boss-parallax {\n    opacity: 0.35;\n  }\n  .boss-atmo-fog {\n    opacity: 0.22;\n    filter: blur(8px);\n  }\n  .screen-world-map.app-viewport::before, .screen-world-map.app-viewport::after {\n    animation: none !important;\n    opacity: 0.18;\n  }\n}\nhtml, body, #root {\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  background: #050914;\n  -webkit-text-size-adjust: 100%;\n}\n* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n  padding: 0;\n  position: fixed;\n  inset: 0;\n  font-family: var(--font-fredoka);\n  overflow: hidden;\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-touch-callout: none;\n  -webkit-tap-highlight-color: transparent;\n  -webkit-font-smoothing: antialiased;\n  background: #050914;\n  overscroll-behavior: none;\n  touch-action: none;\n}\n.app-viewport.sat-juice-correct::after, .app-viewport.sat-juice-wrong::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 90;\n  opacity: 0;\n}\n.app-viewport.sat-juice-correct::after {\n  background: radial-gradient(circle at 45% 58%, rgba(253, 224, 71, 0.22), rgba(125, 211, 252, 0.0) 55%), radial-gradient(circle at 55% 62%, rgba(134, 239, 172, 0.16), rgba(134, 239, 172, 0.0) 60%);\n  animation: sat-correct-pulse 420ms ease-out both;\n}\n.app-viewport.sat-juice-wrong::after {\n  background: radial-gradient(circle at 50% 58%, rgba(244, 63, 94, 0.16), rgba(244, 63, 94, 0.0) 60%), radial-gradient(circle at 50% 58%, rgba(248, 113, 113, 0.10), rgba(248, 113, 113, 0.0) 70%);\n  animation: sat-wrong-flash 320ms ease-out both;\n}\n.game-stage.sat-juice-shake {\n  animation: sat-shake 280ms ease-in-out both;\n}\n@keyframes sat-correct-pulse {\n  0% {\n    opacity: 0;\n  }\n  30% {\n    opacity: 1;\n  }\n  100% {\n    opacity: 0;\n  }\n}\n@keyframes sat-wrong-flash {\n  0% {\n    opacity: 0;\n  }\n  25% {\n    opacity: 1;\n  }\n  100% {\n    opacity: 0;\n  }\n}\n@keyframes sat-shake {\n  0% {\n    transform: translateX(0);\n  }\n  20% {\n    transform: translateX(-6px);\n  }\n  40% {\n    transform: translateX(6px);\n  }\n  60% {\n    transform: translateX(-4px);\n  }\n  80% {\n    transform: translateX(4px);\n  }\n  100% {\n    transform: translateX(0);\n  }\n}\n.app-viewport, .game-viewport, #root {\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-touch-callout: none;\n  -webkit-tap-highlight-color: transparent;\n  touch-action: none;\n  overscroll-behavior: none;\n  overflow: hidden;\n}\ninput, textarea, select, [contenteditable=\"true\"] {\n  user-select: text;\n  -webkit-user-select: text;\n  -webkit-touch-callout: default;\n  touch-action: manipulation;\n}\na, button {\n  -webkit-tap-highlight-color: transparent;\n}\n.app-viewport [class*=\"text-amber-\"], .app-viewport [class*=\"text-yellow-\"], .app-viewport [class*=\"text-orange-\"] {\n  color: #ffffff !important;\n}\n#root {\n  position: relative;\n}\n.game-viewport {\n  width: 100vw;\n  height: 100dvh;\n  overflow: hidden;\n  display: grid;\n  grid-template-rows: calc(56px + env(safe-area-inset-top)) minmax(0, 1fr) calc(72px + env(safe-area-inset-bottom));\n  background: #050914;\n}\n.top-hud {\n  grid-row: 1;\n  width: 100%;\n  height: calc(56px + env(safe-area-inset-top));\n  padding-top: env(safe-area-inset-top);\n  position: relative;\n  z-index: 300;\n  isolation: isolate;\n  overflow: visible;\n}\n.game-stage {\n  grid-row: 2;\n  width: 100%;\n  height: auto;\n  max-height: 100%;\n  min-height: 0;\n  position: relative;\n  z-index: 1;\n  isolation: isolate;\n  overflow: hidden;\n}\n.bottom-hud {\n  grid-row: 3;\n  width: 100%;\n  height: calc(72px + env(safe-area-inset-bottom));\n  padding-bottom: env(safe-area-inset-bottom);\n  position: relative;\n  z-index: 50;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.game-viewport--gameplay {\n  padding-top: env(safe-area-inset-top);\n  padding-bottom: env(safe-area-inset-bottom);\n  grid-template-rows: 10fr 80fr 10fr;\n}\n.game-viewport--gameplay .top-hud, .game-viewport--gameplay .bottom-hud {\n  height: 100%;\n}\n.game-viewport--gameplay .top-hud {\n  padding-top: 0;\n}\n.game-viewport--gameplay .bottom-hud {\n  padding-bottom: 0;\n}\n@media (orientation: landscape) {\n  .game-viewport--gameplay::after {\n    content: 'Portrait only';\n    position: absolute;\n    inset: 0;\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-display);\n    font-weight: 900;\n    letter-spacing: 0;\n    font-size: clamp(1.1rem, 4.5vw, 1.6rem);\n    color: rgba(255, 255, 255, 0.92);\n    background: rgba(5, 9, 20, 0.92);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    pointer-events: auto;\n  }\n}\n.game-background {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.top-hud::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background: linear-gradient(180deg, rgba(10, 24, 58, 0.98) 0%, rgba(7, 18, 45, 0.94) 76%, rgba(7, 18, 45, 0.85) 100%);\n}\n.top-hud::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background: var(--sat-mat-runic), radial-gradient(circle at 50% 0%, rgba(255,255,255,0.10), rgba(255,255,255,0) 52%), linear-gradient(90deg, rgba(2,6,23,0.0), rgba(2,6,23,0.22), rgba(2,6,23,0.0));\n  opacity: 0.14;\n  animation: sat-runic-shimmer 8200ms ease-in-out infinite;\n}\n.top-hud > * {\n  position: relative;\n  z-index: 1;\n}\n.iphone-game-viewport {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  max-height: 100%;\n  overflow: hidden;\n  background: #050914;\n}\n.iphone-game-stage {\n  position: relative;\n  left: auto;\n  top: auto;\n  width: 100%;\n  height: 100%;\n  transform: none;\n  overflow: hidden;\n  background: #050914;\n}\n.iphone-game-stage-gameplay {\n  width: 100%;\n}\n.iphone-game-stage-unbounded {\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n  transform: none;\n}\n.iphone-game-stage-inner {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n.iphone-game-stage .fixed.inset-0:not([data-testid='practice-intro-overlay']) {\n  position: absolute !important;\n  inset: 0 !important;\n}\n.iphone-game-stage .h-screen {\n  height: 100% !important;\n}\n.iphone-game-stage .h-\\[100dvh\\], .iphone-game-stage .h-\\[100vh\\], .iphone-game-stage .h-\\[100svh\\], .iphone-game-stage .h-\\[100lvh\\] {\n  height: 100% !important;\n}\n.iphone-game-stage .max-h-\\[100dvh\\], .iphone-game-stage .max-h-\\[100vh\\], .iphone-game-stage .max-h-\\[100svh\\], .iphone-game-stage .max-h-\\[100lvh\\] {\n  max-height: 100% !important;\n}\n.iphone-game-stage .min-h-\\[100dvh\\], .iphone-game-stage .min-h-\\[100vh\\], .iphone-game-stage .min-h-\\[100svh\\], .iphone-game-stage .min-h-\\[100lvh\\] {\n  min-height: 100% !important;\n}\n.iphone-game-stage .w-screen {\n  width: 100% !important;\n}\n.safe-area-padding {\n  padding-top: 12px;\n  padding-right: 12px;\n  padding-bottom: 12px;\n  padding-left: 12px;\n}\nbutton, input {\n  font: inherit;\n}\nbutton {\n  cursor: pointer;\n  transition: transform 0.14s ease, filter 0.14s ease, box-shadow 0.14s ease;\n  transform-origin: center;\n}\nbutton:not(:disabled):active {\n  transform: translateY(2px) scale(0.985);\n  filter: brightness(0.97);\n}\nbutton:disabled {\n  cursor: not-allowed;\n}\n.cloud-bg {\n  background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.03)), url('/src/assets/fantasy_hero/demo_bg/background_01.png') center/cover no-repeat, linear-gradient(180deg, #9ddcff 0%, #5bb4f1 43%, #1b4f9f 100%);\n  position: relative;\n  overflow: hidden;\n}\n.cloud-bg::before, .cloud-bg::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.cloud-bg::before {\n  background: radial-gradient(circle at 22% 22%, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0) 16%), radial-gradient(circle at 78% 16%, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0) 18%), radial-gradient(circle at 50% 82%, rgba(255,240,196,0.18) 0%, rgba(255,240,196,0) 18%);\n  animation: pulse-bg 12s ease-in-out infinite alternate;\n}\n.cloud-bg::after {\n  background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 20%, rgba(2,6,23,0.22) 100%);\n}\n@keyframes pulse-bg {\n  from {\n    transform: scale(1);\n    opacity: 0.4;\n  }\n  to {\n    transform: scale(1.18);\n    opacity: 0.7;\n  }\n}\n@keyframes splash-glow {\n  from {\n    transform: scale(0.96);\n    opacity: 0.5;\n  }\n  to {\n    transform: scale(1.04);\n    opacity: 0.9;\n  }\n}\n@keyframes splash-shimmer {\n  0% {\n    transform: translateX(-155%) skewX(-18deg);\n    opacity: 0;\n  }\n  18% {\n    opacity: 0.08;\n  }\n  34% {\n    opacity: 0.72;\n  }\n  68% {\n    transform: translateX(150%) skewX(-18deg);\n    opacity: 0.72;\n  }\n  86% {\n    transform: translateX(205%) skewX(-18deg);\n    opacity: 0;\n  }\n  100% {\n    transform: translateX(205%) skewX(-18deg);\n    opacity: 0;\n  }\n}\n@keyframes splash-cta-pulse {\n  0%, 100% {\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), inset 0 -4px 0 rgba(14, 50, 112, 0.92), 0 12px 0 rgba(18, 69, 150, 0.96), 0 26px 42px rgba(7, 24, 56, 0.42), 0 0 0 rgba(255, 194, 45, 0.16), 0 0 28px rgba(59, 130, 246, 0.2);\n  }\n  50% {\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.26), inset 0 -4px 0 rgba(14, 50, 112, 0.9), 0 12px 0 rgba(18, 69, 150, 0.96), 0 28px 46px rgba(7, 24, 56, 0.48), 0 0 20px rgba(255, 201, 66, 0.2), 0 0 34px rgba(59, 130, 246, 0.28);\n  }\n}\n@keyframes hero-cta-pulse {\n  0%, 100% {\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), inset 0 -4px 0 rgba(106, 42, 0, 0.84), 0 10px 0 rgba(18, 69, 150, 0.94), 0 24px 36px rgba(7, 24, 56, 0.34), 0 0 18px rgba(255, 190, 34, 0.18);\n  }\n  50% {\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.24), inset 0 -4px 0 rgba(106, 42, 0, 0.84), 0 10px 0 rgba(18, 69, 150, 0.94), 0 26px 40px rgba(7, 24, 56, 0.4), 0 0 30px rgba(255, 190, 34, 0.26);\n  }\n}\n@keyframes nav-tab-bounce {\n  0% {\n    transform: scale(0.92) translateY(5px);\n  }\n  45% {\n    transform: scale(1.05) translateY(-2px);\n  }\n  100% {\n    transform: scale(1) translateY(0);\n  }\n}\n.cloud {\n  position: absolute;\n  background: rgba(255,255,255,0.8);\n  border-radius: 999px;\n  opacity: 0.58;\n  filter: blur(10px);\n  animation: float linear infinite;\n  box-shadow: inset -12px -12px 24px rgba(15, 23, 42, 0.08), inset 10px 10px 24px rgba(255,255,255,0.72), 0 16px 40px rgba(148, 163, 184, 0.2);\n}\n@keyframes float {\n  from {\n    transform: translateX(-120%);\n  }\n  to {\n    transform: translateX(120vw);\n  }\n}\n.jelly-squish {\n  animation: jelly 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n@keyframes jelly {\n  0% {\n    transform: scale(1, 1);\n  }\n  30% {\n    transform: scale(1.25, 0.75);\n  }\n  40% {\n    transform: scale(0.75, 1.25);\n  }\n  50% {\n    transform: scale(1.15, 0.85);\n  }\n  65% {\n    transform: scale(0.95, 1.05);\n  }\n  75% {\n    transform: scale(1.05, 0.95);\n  }\n  100% {\n    transform: scale(1, 1);\n  }\n}\n.tile-pop {\n  animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n@keyframes pop {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n.shine {\n  position: absolute;\n  top: 0;\n  left: -30%;\n  width: 65%;\n  height: 100%;\n  background: linear-gradient(110deg, rgba(255,255,255,0.34), rgba(255,255,255,0));\n  pointer-events: none;\n  transform: skewX(-20deg);\n}\n.gloss {\n  position: absolute;\n  top: 10%;\n  left: 10%;\n  width: 80%;\n  height: 40%;\n  background: rgba(255,255,255,0.22);\n  border-radius: 50% 50% 40% 40%;\n  pointer-events: none;\n}\n.progress-bar-fill {\n  transition: width 0.35s ease-out;\n}\n.soft-vignette {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: transparent;\n}\n@keyframes hud-shine {\n  0% {\n    background-position: 200% 0;\n  }\n  100% {\n    background-position: -20% 0;\n  }\n}\n.game-dock-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 3.4rem;\n  height: 3.4rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(255,255,255,0.14);\n  background: url('/src/assets/reskin/main_png/booster_holder.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(56,189,248,0.98), rgba(37,99,235,0.98));\n  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.24), 0 4px 0 rgba(21,60,153,0.72);\n  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;\n}\n.game-dock-button:hover {\n  transform: translateY(-2px) scale(1.03);\n  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.2), inset 0 2px 8px rgba(255,255,255,0.72);\n}\n.game-dock-button:active {\n  transform: translateY(1px) scale(0.96);\n  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.22), 0 2px 0 rgba(21,60,153,0.76);\n}\n.fantasy-dock-shell {\n  border-radius: 1.4rem;\n  border: 1px solid rgba(255,255,255,0.14);\n  background: url('/src/assets/reskin/main_png/text_box.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(18,29,54,0.96), rgba(8,14,27,0.98));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), 0 18px 34px rgba(2,6,23,0.28);\n}\n.fantasy-hud-shell {\n  border: 1px solid rgba(255,255,255,0.18);\n  background: url('/src/assets/reskin/main_png/mission.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(30,58,138,0.96), rgba(15,23,42,0.98));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 18px 36px rgba(2,6,23,0.34);\n}\n.fantasy-hud-shell::before {\n  content: '';\n  position: absolute;\n  inset: 0.28rem;\n  border-radius: inherit;\n  border: 1px solid rgba(255,255,255,0.08);\n  pointer-events: none;\n}\n.licensed-shell-bg {\n  position: relative;\n  background: transparent;\n}\n.licensed-playfield-bg {\n  position: relative;\n  background: transparent;\n}\n.licensed-shell-bg::before, .licensed-shell-bg::after, .licensed-playfield-bg::before, .licensed-playfield-bg::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.licensed-shell-bg::before, .licensed-playfield-bg::before {\n  background: transparent;\n  animation: none;\n  opacity: 0;\n}\n.licensed-shell-bg::after, .licensed-playfield-bg::after {\n  background: transparent;\n  opacity: 0;\n}\n.licensed-wood-button {\n  border: 2px solid rgba(255,255,255,0.18);\n  color: #fff8ec;\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0)), linear-gradient(180deg, rgba(255,205,86,0.98), rgba(245,154,24,0.98));\n  box-shadow: 0 8px 0 rgba(138,84,12,0.82), 0 16px 30px rgba(0,0,0,0.22);\n  text-shadow: 0 2px 0 rgba(0,0,0,0.35);\n}\n.licensed-wood-button:hover {\n  filter: brightness(1.04);\n}\n.licensed-wood-button-secondary {\n  border: 2px solid rgba(255,255,255,0.16);\n  color: #fff7ea;\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0)), linear-gradient(180deg, rgba(96,165,250,0.98), rgba(59,130,246,0.98));\n  box-shadow: 0 8px 0 rgba(29, 78, 216, 0.72), 0 12px 24px rgba(0,0,0,0.18);\n  text-shadow: 0 2px 0 rgba(0,0,0,0.35);\n}\n.licensed-game-card {\n  border: 1px solid rgba(255,255,255,0.12);\n  border-radius: 1.6rem;\n  background: url('/src/assets/casual_ui/dialogs_panels/card_1.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(30,58,138,0.94), rgba(14,23,52,0.95));\n  box-shadow: 0 10px 0 rgba(30,64,175,0.54), 0 22px 40px rgba(0,0,0,0.18);\n}\n.licensed-game-card-dark {\n  border: 1px solid rgba(255,255,255,0.12);\n  border-radius: 1.6rem;\n  background: url('/src/assets/casual_ui/dialogs_panels/card_2.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(23,37,84,0.96), rgba(15,23,42,0.98));\n  box-shadow: 0 10px 0 rgba(30, 41, 59, 0.78), 0 20px 32px rgba(0,0,0,0.2);\n}\n.licensed-panel-plank {\n  border: 1px solid rgba(255,255,255,0.18);\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0));\n  color: #fff7ea;\n  text-shadow: 0 2px 0 rgba(0,0,0,0.28);\n}\n.licensed-submit-button {\n  border: 0;\n  color: #15213d;\n  background: var(--sat-button-primary-skin) center/100% 100% no-repeat;\n  background-color: transparent;\n  min-height: var(--sat-pill-height);\n  padding-inline: 1rem;\n  border-radius: 0;\n  box-shadow: none;\n  text-shadow: none;\n  filter: none;\n  transform: none;\n}\n.licensed-answer-button {\n  border: 2px solid rgba(255,255,255,0.14);\n  color: #fff8ec;\n  min-height: var(--sat-pill-height);\n  padding-inline: 1rem;\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0)), linear-gradient(180deg, rgba(34,211,238,0.98), rgba(14,116,144,0.98));\n  border-radius: var(--sat-pill-radius);\n  box-shadow: 0 7px 0 rgba(67, 56, 202, 0.62), 0 14px 24px rgba(0,0,0,0.16);\n  text-shadow: 0 2px 0 rgba(0,0,0,0.28);\n}\n.licensed-answer-button:hover {\n  filter: brightness(1.04);\n}\n.licensed-answer-button:active {\n  transform: translateY(2px);\n  box-shadow: 0 3px 0 rgba(37,99,235,0.62);\n}\n.licensed-answer-chip {\n  border: 2px solid rgba(59,130,246,0.32);\n  border-radius: 1rem;\n  background: rgba(255,255,255,0.92);\n  box-shadow: 0 6px 0 rgba(37,99,235,0.14);\n}\n.licensed-board-frame {\n  border: 4px solid transparent;\n  border-radius: 1.5rem;\n  background: url('/src/assets/casual_ui/dialogs_panels/panel_3.png') center/100% 100% no-repeat;\n  box-shadow: 0 16px 32px rgba(0,0,0,0.25);\n}\n.licensed-overlay-card {\n  border: 4px solid transparent;\n  border-radius: 1.5rem;\n  background: url('/src/assets/casual_ui/dialogs_panels/panel.png') center/100% 100% no-repeat;\n  box-shadow: 0 12px 24px rgba(0,0,0,0.3);\n  color: #fff7ea;\n}\n.licensed-input-panel {\n  border: 2px solid rgba(92,58,30,0.48);\n  border-radius: 1.25rem;\n  background: rgba(255, 248, 235, 0.9);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.65), 0 6px 0 rgba(92,58,30,0.14);\n}\n.licensed-slice-paper-panel {\n  border: 1px solid rgba(120, 67, 24, 0.18);\n  border-radius: 1.55rem;\n  background: url('/src/assets/licensed/slices/panel_paper.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(255,247,230,0.96), rgba(244,221,182,0.96));\n  box-shadow: 0 10px 0 rgba(133, 81, 28, 0.24), 0 18px 30px rgba(15,23,42,0.14);\n}\n.licensed-slice-blue-banner {\n  border: 1px solid rgba(169, 219, 255, 0.55);\n  color: #f0fbff;\n  text-shadow: 0 1px 0 rgba(14, 69, 126, 0.52);\n  background: url('/src/assets/reskin/main_png/text_box.png') center/100% 100% no-repeat, linear-gradient(180deg, rgba(74,166,255,0.98), rgba(42,106,224,0.98));\n  box-shadow: 0 8px 0 rgba(24, 78, 154, 0.54), 0 16px 28px rgba(15,23,42,0.2);\n}\n.licensed-slice-orange-pill {\n  border: 0;\n  color: #fff7ea;\n  text-shadow: 0 1px 0 rgba(124, 45, 18, 0.34);\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0));\n}\n.licensed-slice-cyan-pill {\n  border: 0;\n  color: #f8fffe;\n  text-shadow: 0 1px 0 rgba(8, 78, 89, 0.34);\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0));\n}\n.licensed-slice-green-pill {\n  border: 0;\n  color: #f5fffb;\n  text-shadow: 0 1px 0 rgba(21, 94, 57, 0.3);\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0));\n}\n.licensed-slice-yellow-plank {\n  border: 0;\n  color: #fff8eb;\n  text-shadow: 0 1px 0 rgba(120, 53, 15, 0.34);\n  background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,0));\n}\n.licensed-grid-backdrop {\n  background-image: linear-gradient(rgba(148,163,184,0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,0.16) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n.licensed-slider {\n  accent-color: #3cc7c4;\n}\n.licensed-stat-badge {\n  border: 2px solid rgba(92,58,30,0.6);\n  border-radius: 1rem;\n  background: rgba(255,248,235,0.92);\n  box-shadow: 0 6px 0 rgba(92,58,30,0.14);\n}\n.app-viewport {\n  --premium-page-max-width: 76rem;\n  width: 100%;\n  height: 100%;\n  max-height: 100%;\n  overflow: hidden;\n}\n.app-viewport.screen-gameplay {\n  position: relative;\n  isolation: isolate;\n}\n.app-viewport.screen-gameplay::before, .app-viewport.screen-gameplay::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 0;\n}\n.app-viewport.screen-gameplay::before {\n  background: radial-gradient(circle at 18% 18%, rgba(125, 211, 252, 0.18), transparent 18%), radial-gradient(circle at 82% 22%, rgba(251, 191, 36, 0.14), transparent 16%), radial-gradient(circle at 52% 78%, rgba(167, 139, 250, 0.12), transparent 20%);\n  opacity: 0.55;\n  animation: game-ambient-drift 16s ease-in-out infinite alternate;\n  mix-blend-mode: screen;\n}\n.app-viewport.screen-gameplay::after {\n  background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.045) 48%, rgba(255,255,255,0) 100%);\n  opacity: 0.45;\n  transform: translateX(-16%);\n  animation: game-ambient-sheen 12s linear infinite;\n}\n.unified-minigame-hud-enabled .game-shell-zone-hud, .unified-minigame-hud-enabled .mission-hud-root, .unified-minigame-hud-enabled .mini-game-top-bar {\n  display: none !important;\n}\n.unified-minigame-hud-enabled .game-shell-zone-actions {\n  display: none !important;\n}\n.sat-shell-standard {\n  position: relative;\n}\n.sat-shell-map {\n  position: relative;\n}\n.sat-screen-standard-content {\n  min-height: 0;\n  width: 100%;\n  max-width: min(var(--premium-page-max-width), 100%);\n  margin-inline: auto;\n}\n.sat-screen-full-bleed {\n  min-height: 0;\n  width: 100%;\n  max-width: none;\n  margin-inline: 0;\n}\n.sat-screen-map-content {\n  min-height: 0;\n  width: 100%;\n  max-width: min(64rem, 100%);\n  margin-inline: auto;\n}\n.app-modal-panel {\n  max-height: calc(100dvh - 2rem);\n}\n.licensed-overlay-card, .app-modal-panel, .casual-modal-panel, .premium-modal-shell, .licensed-overlay-card *, .app-modal-panel *, .casual-modal-panel *, .premium-modal-shell * {\n  color: #ffffff !important;\n}\n.ui-close-button {\n  height: 2rem;\n  width: 2rem;\n  border-radius: 9999px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  background: rgba(2, 6, 23, 0.28);\n  color: rgba(255, 255, 255, 0.92);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 900;\n  font-size: 1rem;\n  line-height: 1;\n  box-shadow: 0 8px 18px rgba(2, 6, 23, 0.28);\n}\n.ui-close-button span {\n  display: inline-block;\n  transform: translateY(-1px);\n}\n.premium-page-root {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n}\n.premium-page-content {\n  width: 100%;\n  max-width: min(var(--premium-page-max-width), 100%);\n  margin-inline: auto;\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  gap: clamp(0.5rem, 1.4vh, 0.95rem);\n  padding-inline: clamp(0.75rem, 2.8vw, 1.5rem);\n  padding-top: calc(env(safe-area-inset-top) + clamp(0.45rem, 1.5vh, 0.85rem));\n  padding-bottom: calc(env(safe-area-inset-bottom) + clamp(0.5rem, 1.8vh, 1rem));\n}\n.premium-page-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: clamp(0.55rem, 2vw, 1rem);\n  flex: 0 0 auto;\n}\n.premium-page-scroll {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding-right: clamp(0rem, 0.8vw, 0.35rem);\n}\n.premium-map-stage {\n  position: relative;\n  flex: 1 1 auto;\n  min-height: 0;\n  width: 100%;\n}\n.premium-map-stage.premium-map-stage-fullscreen {\n  flex: 0 0 auto;\n  min-height: 100%;\n  height: auto;\n  width: 100%;\n  max-width: none;\n  aspect-ratio: auto;\n  margin-inline: 0;\n}\n.premium-modal-shell {\n  width: min(94vw, 52rem);\n  border-radius: clamp(1.15rem, 2.2vw, 2rem);\n  max-height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - clamp(1rem, 3vh, 2rem));\n}\n@media (min-width: 768px) {\n  .premium-page-content {\n    gap: clamp(0.7rem, 1.6vh, 1.15rem);\n    padding-inline: clamp(1rem, 3.4vw, 2rem);\n    padding-top: calc(env(safe-area-inset-top) + clamp(0.65rem, 1.8vh, 1.15rem));\n    padding-bottom: calc(env(safe-area-inset-bottom) + clamp(0.8rem, 2.4vh, 1.45rem));\n  }\n  .premium-map-stage {\n    min-height: calc(100% - 0.5rem);\n    aspect-ratio: 1024 / 1792;\n    max-width: min(56rem, 100%);\n    margin-inline: auto;\n  }\n  .premium-map-stage.premium-map-stage-fullscreen {\n    min-height: 100%;\n    aspect-ratio: auto;\n    max-width: none;\n    margin-inline: 0;\n  }\n}\n.casual-modal-panel {\n  border: 1px solid rgba(255,255,255,0.14);\n  background: radial-gradient(circle at top, rgba(96,165,250,0.18), transparent 30%), radial-gradient(circle at bottom right, rgba(56,189,248,0.14), transparent 30%), linear-gradient(180deg, rgba(26,38,72,0.98), rgba(11,17,31,0.98));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), 0 24px 70px rgba(0,0,0,0.42);\n}\n.casual-panel-surface {\n  border: 1px solid rgba(255,255,255,0.12);\n  background: radial-gradient(circle at top, rgba(96,165,250,0.1), transparent 22%), linear-gradient(180deg, rgba(28,43,82,0.98), rgba(8,14,28,0.99));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), 0 16px 40px rgba(0,0,0,0.28);\n}\n.casual-panel-strong {\n  border: 1px solid rgba(255,255,255,0.14);\n  background: radial-gradient(circle at top, rgba(34,211,238,0.12), transparent 22%), radial-gradient(circle at bottom, rgba(250,204,21,0.06), transparent 30%), linear-gradient(180deg, rgba(25,39,74,0.985), rgba(8,14,27,0.995));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,