 background: linear-gradient(180deg, rgba(255,248,169,0.98), rgba(255,163,48,0.98) 40%, rgba(255,86,24,0.96) 78%, rgba(170,26,0,0));\n  box-shadow: 0 0 16px rgba(255,114,31,0.32);\n  animation-name: world-map-lava-spurt;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-lava-spurt::after {\n  content: '';\n  position: absolute;\n  left: 50%;\n  bottom: -0.15rem;\n  width: 0.9rem;\n  height: 0.34rem;\n  border-radius: 999px;\n  background: radial-gradient(circle, rgba(255,110,43,0.42), rgba(255,110,43,0));\n  transform: translateX(-50%);\n}\n@keyframes world-map-orbit {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n@keyframes world-map-island-breathe {\n  0%, 100% {\n    transform: scale(0.995);\n  }\n  50% {\n    transform: scale(1.008);\n  }\n}\n@keyframes world-map-island-glow {\n  0%, 100% {\n    transform: scale(0.94);\n    opacity: 0.16;\n  }\n  50% {\n    transform: scale(1.03);\n    opacity: 0.34;\n  }\n}\n@keyframes world-map-volcano-flame {\n  0%, 100% {\n    transform: translateY(0) scaleY(0.78) scaleX(0.92);\n    opacity: 0.74;\n  }\n  50% {\n    transform: translateY(-0.22rem) scaleY(1.18) scaleX(1.04);\n    opacity: 1;\n  }\n}\n@keyframes world-map-volcano-smoke {\n  0%, 100% {\n    transform: translateY(0) scale(0.94);\n    opacity: 0.3;\n  }\n  50% {\n    transform: translateY(-0.28rem) scale(1.08);\n    opacity: 0.62;\n  }\n}\n@keyframes world-map-lava-rock-burst {\n  0% {\n    transform: translate3d(0, 0.35rem, 0) rotate(-12deg) scale(0.58);\n    opacity: 0;\n  }\n  12% {\n    opacity: 1;\n  }\n  48% {\n    transform: translate3d(var(--lava-rock-drift, 0.18rem), -2.3rem, 0) rotate(96deg) scale(1);\n    opacity: 1;\n  }\n  78% {\n    opacity: 0.82;\n  }\n  100% {\n    transform: translate3d(var(--lava-rock-drift-end, -0.35rem), -4.45rem, 0) rotate(208deg) scale(0.72);\n    opacity: 0;\n  }\n}\n@keyframes world-map-core-smoke {\n  0%, 100% {\n    transform: translateY(0) scale(0.88);\n    opacity: 0.42;\n  }\n  50% {\n    transform: translateY(-0.14rem) scale(1.08);\n    opacity: 0.82;\n  }\n}\n@keyframes world-map-core-swirl {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n@keyframes world-map-acropolis-swirl {\n  0% {\n    transform: translate(-50%, -50%) rotate(0deg) scale(0.96);\n    opacity: 0.52;\n  }\n  50% {\n    transform: translate(-50%, -50%) rotate(180deg) scale(1.04);\n    opacity: 0.9;\n  }\n  100% {\n    transform: translate(-50%, -50%) rotate(360deg) scale(0.96);\n    opacity: 0.52;\n  }\n}\n@keyframes world-map-acropolis-spark {\n  0%, 100% {\n    opacity: 0.42;\n    filter: drop-shadow(0 0 0 rgba(255,255,255,0));\n  }\n  50% {\n    opacity: 1;\n    filter: drop-shadow(0 0 8px rgba(255,255,255,0.38));\n  }\n}\n@keyframes world-map-butterfly-drift {\n  0%, 100% {\n    transform: translate3d(0, 0, 0) scale(0.88) rotate(-5deg);\n    opacity: 0.78;\n  }\n  25% {\n    transform: translate3d(0.5rem, -0.55rem, 0) scale(1) rotate(6deg);\n    opacity: 1;\n  }\n  50% {\n    transform: translate3d(1rem, -0.15rem, 0) scale(0.94) rotate(-8deg);\n    opacity: 0.92;\n  }\n  75% {\n    transform: translate3d(0.35rem, 0.5rem, 0) scale(1.02) rotate(4deg);\n    opacity: 0.84;\n  }\n}\n@keyframes world-map-bubble-rise {\n  0% {\n    transform: translate3d(0, 0.4rem, 0) scale(0.66);\n    opacity: 0;\n  }\n  20% {\n    opacity: 0.78;\n  }\n  80% {\n    opacity: 0.52;\n  }\n  100% {\n    transform: translate3d(0.35rem, -3rem, 0) scale(1.1);\n    opacity: 0;\n  }\n}\n@keyframes world-map-sparkle-pop {\n  0%, 100% {\n    transform: rotate(45deg) scale(0.64);\n    opacity: 0;\n  }\n  25% {\n    opacity: 0.92;\n  }\n  55% {\n    transform: rotate(45deg) scale(1);\n    opacity: 1;\n  }\n  85% {\n    opacity: 0.28;\n  }\n}\n@keyframes world-map-light-beam-flash {\n  0%, 100% {\n    opacity: 0;\n  }\n  18% {\n    opacity: 0;\n  }\n  34% {\n    opacity: 0.78;\n  }\n  55% {\n    opacity: 0.34;\n  }\n  72% {\n    opacity: 0;\n  }\n}\n@keyframes world-map-dust-devil-spin {\n  0% {\n    transform: translate3d(0, 0.2rem, 0) scale(0.84) rotate(0deg);\n    opacity: 0;\n  }\n  20% {\n    opacity: 0.78;\n  }\n  70% {\n    opacity: 0.56;\n  }\n  100% {\n    transform: translate3d(0.35rem, -1.1rem, 0) scale(1.02) rotate(22deg);\n    opacity: 0;\n  }\n}\n@keyframes world-map-snowfall {\n  0% {\n    transform: translate3d(0, -0.2rem, 0) scale(0.72);\n    opacity: 0;\n  }\n  15% {\n    opacity: 0.82;\n  }\n  100% {\n    transform: translate3d(-0.75rem, 2.4rem, 0) scale(1);\n    opacity: 0;\n  }\n}\n@keyframes world-map-snow-gust {\n  0% {\n    transform: translate3d(0, 0, 0) scaleX(0.72);\n    opacity: 0;\n  }\n  20% {\n    opacity: 0.9;\n  }\n  100% {\n    transform: translate3d(1.6rem, 0.75rem, 0) scaleX(1.08);\n    opacity: 0;\n  }\n}\n@keyframes world-map-wind-wisp {\n  0% {\n    transform: translate3d(-0.2rem, 0, 0) scaleX(0.72);\n    opacity: 0;\n  }\n  18% {\n    opacity: 0.7;\n  }\n  70% {\n    opacity: 0.32;\n  }\n  100% {\n    transform: translate3d(1.2rem, -0.42rem, 0) scaleX(1.1);\n    opacity: 0;\n  }\n}\n@keyframes world-map-lava-spurt {\n  0%, 100% {\n    transform: translate3d(0, 0, 0) scaleY(0.6);\n    opacity: 0;\n  }\n  16% {\n    opacity: 0.96;\n  }\n  42% {\n    transform: translate3d(0, -1.2rem, 0) scaleY(1);\n    opacity: 1;\n  }\n  72% {\n    opacity: 0.56;\n  }\n  100% {\n    transform: translate3d(0, -1.85rem, 0) scaleY(0.82);\n    opacity: 0;\n  }\n}\n.hero-card-shell {\n  position: relative;\n  background: radial-gradient(circle at 50% 8%, rgba(255,255,255,0.12), rgba(255,255,255,0) 30%), linear-gradient(180deg, rgba(32,49,96,0.94), rgba(10,18,37,0.985));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), inset 0 -10px 22px rgba(2,6,23,0.34), 0 18px 34px rgba(2,6,23,0.34);\n}\n.hero-card-shell::before, .hero-card-shell::after {\n  content: '';\n  position: absolute;\n  pointer-events: none;\n  border-radius: inherit;\n}\n.hero-card-shell::before {\n  inset: 0.3rem;\n  border: 1px solid rgba(255,255,255,0.1);\n  opacity: 0.88;\n}\n.hero-card-shell::after {\n  inset: auto 12% 1.15rem;\n  height: 1.5rem;\n  background: radial-gradient(circle, rgba(255,241,150,0.14), rgba(255,241,150,0) 72%);\n  filter: blur(9px);\n}\n.hero-card-shell-selected {\n  background: radial-gradient(circle at 50% 8%, rgba(255,244,196,0.2), rgba(255,244,196,0) 30%), linear-gradient(180deg, rgba(50,78,146,0.96), rgba(13,23,49,0.985));\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.14), inset 0 -1px 0 rgba(255,196,82,0.18), 0 20px 0 rgba(15,30,83,0.9), 0 30px 56px rgba(2,6,23,0.4), 0 0 0 1px rgba(255,213,107,0.18);\n}\n.hero-card-shell-side {\n  filter: saturate(0.7) brightness(0.86) blur(0.45px);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 12px 24px rgba(2,6,23,0.24);\n}\n.hero-arrow-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 3.5rem;\n  height: 3.5rem;\n  padding: 0.22rem;\n  border: 0;\n  border-radius: 1.3rem;\n  background: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.22), rgba(255,255,255,0) 34%), linear-gradient(180deg, #2f8df5 0%, #1f63cf 46%, #163d8a 100%);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), inset 0 -4px 0 rgba(14,50,112,0.9), 0 10px 0 rgba(18,69,150,0.96), 0 18px 26px rgba(2,6,23,0.24);\n}\n.hero-arrow-button:hover {\n  filter: brightness(1.04) saturate(1.04);\n}\n.hero-arrow-button-clean {\n  width: 2.8rem;\n  height: 2.8rem;\n  padding: 0.16rem;\n  border-radius: 1rem;\n  background: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.18), rgba(255,255,255,0) 36%), linear-gradient(180deg, #2f8df5 0%, #1f63cf 46%, #163d8a 100%);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), inset 0 -3px 0 rgba(14,50,112,0.88), 0 7px 0 rgba(18,69,150,0.92), 0 16px 20px rgba(2,6,23,0.2);\n}\n.hero-arrow-button:active {\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), inset 0 -3px 0 rgba(14,50,112,0.9), 0 5px 0 rgba(18,69,150,0.96)