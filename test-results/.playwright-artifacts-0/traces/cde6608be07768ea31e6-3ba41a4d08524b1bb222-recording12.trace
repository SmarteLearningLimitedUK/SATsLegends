osition: absolute;\n  top: -30%;\n  left: -18%;\n  width: 30%;\n  height: 180%;\n  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.76) 50%, rgba(255,255,255,0) 100%);\n  transform: translateX(-140%) skewX(-18deg);\n  animation: splash-shimmer 3.5s ease-in-out infinite;\n}\n.hero-cta-button-orb {\n  position: absolute;\n  top: 50%;\n  width: 0.8rem;\n  height: 0.8rem;\n  border-radius: 0.2rem;\n  background: linear-gradient(180deg, #fff0a6 0%, #ffd14a 54%, #d17f0d 100%);\n  transform: translateY(-50%) rotate(45deg);\n  box-shadow: 0 0 12px rgba(255,205,90,0.38);\n  z-index: 2;\n}\n.hero-cta-button-orb-left {\n  left: 1rem;\n}\n.hero-cta-button-orb-right {\n  right: 1rem;\n}\n.hero-cta-button-label {\n  position: relative;\n  z-index: 2;\n  padding: 1.02rem 3rem 1.12rem;\n  font-family: var(--font-display);\n  font-size: clamp(1.16rem, 4.2vw, 1.78rem);\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: 0.07em;\n  text-transform: uppercase;\n  color: #173b79;\n  text-shadow: 0 1px 0 rgba(255,249,221,0.95), 0 4px 12px rgba(122, 51, 0, 0.16);\n}\n.hero-cta-button-large .hero-cta-button-label {\n  padding: 1.16rem 3.2rem 1.24rem;\n  font-size: clamp(1.22rem, 4.4vw, 1.92rem);\n}\n.hero-cta-button:hover {\n  filter: brightness(1.03) saturate(1.03);\n}\n.hero-cta-button:not(:disabled):active {\n  transform: translateY(2px) scale(0.985);\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.16), inset 0 -3px 0 rgba(14,50,112,0.88), 0 5px 0 rgba(18, 69, 150, 0.94), 0 14px 24px rgba(7, 24, 56, 0.26), 0 0 14px rgba(255, 190, 34, 0.14);\n}\n.hero-cta-button:not(:disabled):active .hero-cta-button-face {\n  transform: translateY(1px);\n  background: linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0) 18%), radial-gradient(circle at 50% 0%, rgba(255,247,207,0.68), rgba(255,247,207,0) 30%), linear-gradient(180deg, #f3e187 0%, #f8c836 20%, #eea70c 54%, #d97903 100%);\n}\n.splash-continue-button {\n  position: relative;\n  display: inline