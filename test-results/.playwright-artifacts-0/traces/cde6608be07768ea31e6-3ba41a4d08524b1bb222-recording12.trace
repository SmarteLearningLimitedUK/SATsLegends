th-glow {\n  opacity: 0.42;\n  filter: blur(0.4px) drop-shadow(0 0 10px rgba(56,189,248,0.22)) drop-shadow(0 0 18px rgba(251,191,36,0.18));\n}\n.world-map-journey-path {\n  opacity: 0.95;\n  filter: drop-shadow(0 0 8px rgba(56,189,248,0.24));\n  animation: world-map-journey-dash 10.5s linear infinite;\n}\n.world-map-journey-node {\n  transform-origin: center;\n  animation: world-map-journey-node 3.6s ease-in-out infinite;\n  filter: drop-shadow(0 0 10px rgba(125,211,252,0.22));\n}\n@keyframes world-map-journey-dash {\n  0% {\n    stroke-dashoffset: 0;\n  }\n  100% {\n    stroke-dashoffset: -210;\n  }\n}\n@keyframes world-map-journey-node {\n  0% {\n    opacity: 0.24;\n    transform: scale(0.92);\n  }\n  45% {\n    opacity: 0.58;\n    transform: scale(1.08);\n  }\n  100% {\n    opacity: 0.24;\n    transform: scale(0.92);\n  }\n}\n.world-map-island-breathe {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  will-change: transform, opacity;\n  animation-name: world-map-island-breathe;\n  animation-timing-function: ease-in-out;\n  animation-iteration-count: infinite;\n}\n.world-map-island-breathe::before, .world-map-island-breathe::after, .world-map-island-halo {\n  content: '';\n  position: absolute;\n  inset: 12% 10%;\n  border-radius: 999px;\n  background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.26), rgba(255,255,255,0.05) 30%, rgba(255,255,255,0) 72%);\n  mix-blend-mode: screen;\n  filter: blur(10px);\n  opacity: 0.34;\n}\n.world-map-island-breathe::before {\n  animation: world-map-island-glow 4.6s ease-in-out infinite;\n}\n.world-map-island-breathe::after {\n  inset: 20% 18%;\n  opacity: 0.16;\n  filter: blur(16px);\n  animation: world-map-island-glow 5.8s ease-in-out infinite reverse;\n}\n.world-map-island-halo {\n  inset: 28% 20%;\n  opacity: 0.18;\n  filter: blur(14px);\n  animation: world-map-island-glow 6.4s ease-in-out infinite;\n}\n.world-map-volcano-accent {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.world-map-volcano-flame {\n  position: absolute;\n  border-radius: 999px 999px 42% 42%;\n  mix-blend-mode: screen;\n  filter: blur(0.5px);\n  transform-origin: center bottom;\n  animation: world-map-volcano-flame 1.9s ease-in-out infinite;\n}\n.world-map-volcano-flame-primary {\n  left: 28%;\n  top: -2%;\n  width: 18%;\n  height: 34%;\n  background: radial-gradient(circle at 50% 15%, rgba(255,255,255,0.92), rgba(255,239,138,0.92) 22%, rgba(255,149,37,0.96) 55%, rgba(255,86,24,0.74) 75%, rgba(170,26,0,0) 100%);\n  box-shadow: 0 0 20px rgba(255, 118, 31, 0.25);\n}\n.world-map-volcano-flame-secondary {\n  left: 34%;\n  top: 3%;\n  width: 12%;\n  height: 22%;\n  background: radial-gradient(circle at 50% 12%, rgba(255,255,255,0.88), rgba(255,227,120,0.88) 28%, rgba(255,130,28,0.82) 64%, rgba(170,26,0,0) 100%);\n  animation-delay: 0.25s;\n  box-shadow: 0 0 16px rgba(255, 142, 52, 0.2);\n}\n.world-map-volcano-flame-tertiary {\n  left: 40%;\n  top: 1%;\n  width: 10%;\n  height: 28%;\n  background: radial-gradient(circle at 50% 12%, rgba(255,255,255,0.82), rgba(255,215,84,0.86) 24%, rgba(255,124,28,0.82) 60%, rgba(170,26,0,0) 100%);\n  animation-delay: 0.5s;\n  box-shadow: 0 0 14px rgba(255, 182, 74, 0.22);\n}\n.world-map-volcano-smoke {\n  position: absolute;\n  left: 27%;\n  top: -8%;\n  width: 18%;\n  height: 18%;\n  border-radius: 999px;\n  background: radial-gradient(circle at 50% 40%, rgba(255,255,255,0.16), rgba(255,255,255,0.06) 42%, rgba(255,255,255,0) 74%);\n  filter: blur(10px);\n  opacity: 0.52;\n  animation: world-map-volcano-smoke 3.8s ease-in-out infinite;\n}\n.world-map-lava-rock {\n  position: absolute;\n  bottom: 34%;\n  width: 0.72rem;\n  height: 0.58rem;\n  border-radius: 42% 58% 48% 52%;\n  background: radial-gradient(circle at 36% 28%, rgba(255,229,135,0.96), rgba(255,132,34,0.88) 32%, rgba(130,34,15,0.96) 68%, rgba(42,18,12,0.98) 100%);\n  box-shadow: 0 0 0.42rem rgba(255,96,28,0.5), inset -0.08rem -0.06rem 0.12rem rgba(42,18,12,0.5);\n  filter: drop-shadow(0 0 0.22rem rgba(255,100,36,0.42));\n  opacity: 0;\n  transform-origin: center;\n  animation-name: world-map-lava-rock-burst;\n  animation-timing-function: cubic-bezier(0.18, 0.78, 0.28, 1);\n  animation-iteration-count: infinite;\n}\n.world-map-lava-rock::after {\n  content: '';\n  position: absolute;\n  left: 50%;\n  top: 75%;\n  width: 0.18rem;\n  height: 1rem;\n  border-radius: 999px;\n  background: linear-gradient(180deg, rgba(255,221,97,0.58), rgba(255,92,28,0.18), rgba(255,92,28,0));\n  transform: translateX(-50%);\n}\n.world-map-lava-rock-1 {\n  left: 31%;\n  --lava-rock-drift: -0.34rem;\n  --lava-rock-drift-end: -0.72rem;\n}\n.world-map-lava-rock-2 {\n  left: 40%;\n  width: 0.58rem;\n  height: 0.5rem;\n  --lava-rock-drift: 0.12rem;\n  --lava-rock-drift-end: 0.4rem;\n}\n.world-map-lava-rock-3 {\n  left: 48%;\n  bottom: 31%;\n  width: 0.82rem;\n  height: 0.64rem;\n  --lava-rock-drift: -0.08rem;\n  --lava-rock-drift-end: -0.24rem;\n}\n.world-map-lava-rock-4 {\n  left: 56%;\n  width: 0.5rem;\n  height: 0.46rem;\n  --lava-rock-drift: 0.28rem;\n  --lava-rock-drift-end: 0.74rem;\n}\n.world-map-lava-rock-5 {\n  left: 64%;\n  bottom: 32%;\n  width: 0.68rem;\n  height: 0.54rem;\n  --lava-rock-drift: -0.18rem;\n  --lava-rock-drift-end: 0.16rem;\n}\n.world-map-core-smoke {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.world-map-core-smoke-ring {\n  position: absolute;\n  border-radius: 999px;\n  border: 2px solid rgba(99, 102, 241, 0.22);\n  border-top-color: rgba(34, 197, 94, 0.42);\n  border-right-color: rgba(168, 85, 247, 0.46);\n  border-bottom-color: rgba(34, 197, 94, 0.18);\n  border-left-color: rgba(168, 85, 247, 0.22);\n  filter: blur(0.5px);\n  mix-blend-mode: screen;\n  animation: world-map-core-swirl 6.4s linear infinite;\n}\n.world-map-core-smoke-ring-a {\n  left: 45%;\n  top: 2%;\n  width: 24%;\n  height: 24%;\n}\n.world-map-core-smoke-ring-b {\n  left: 49%;\n  top: 4%;\n  width: 18%;\n  height: 18%;\n  animation-direction: reverse;\n  